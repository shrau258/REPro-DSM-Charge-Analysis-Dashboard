# Copy to .env and fill in credentials locally. Never commit .env.
REPRO_USERNAME=your_portal_username
REPRO_PASSWORD=your_portal_password
REPRO_HEADLESS=false
REPRO_DB_PATH=reports.sqlite3
REPRO_DOWNLOAD_DIR=downloads

# PostgreSQL report database (keep the existing SQLite file for migration)
REPRO_DB_BACKEND=postgres
REPRO_PG_HOST=localhost
REPRO_PG_PORT=5432
REPRO_PG_DATABASE=repro_reports
REPRO_PG_USER=postgres
REPRO_PG_PASSWORD=your_postgres_password
REPRO_SQLITE_PATH=reports.sqlite3
