# Copy to .env and fill in credentials locally. Never commit .env.
REPRO_USERNAME=your_portal_username
REPRO_PASSWORD=your_portal_password
REPRO_HEADLESS=false
REPRO_DB_PATH=reports.sqlite3
REPRO_DOWNLOAD_DIR=downloads

# PostgreSQL report database (keep the existing SQLite file for migration)
REPRO_DB_BACKEND=postgres
REPRO_PG_HOST=localhost
REPRO_PG_PORT=5432
REPRO_PG_DATABASE=repro_reports
REPRO_PG_USER=postgres
REPRO_PG_PASSWORD=your_postgres_password
REPRO_SQLITE_PATH=reports.sqlite3

# Local mode is for a single-user workstation. For company-network hosting,
# set REPRO_AUTH_REQUIRED=true and place the app behind a trusted SSO proxy.
# The proxy must remove any client-supplied identity header and inject its own.
REPRO_AUTH_REQUIRED=false
REPRO_AUTH_USER_HEADER=X-Authenticated-User
REPRO_AUTH_ROLES_HEADER=X-Authenticated-Roles
REPRO_ADMIN_ROLE=DSM-Admin
REPRO_AUTOMATION_ROLE=DSM-Users
REPRO_TRUSTED_PROXY_IPS=127.0.0.1,::1
REPRO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
