# Copy values into the service deployment's private .env; do not commit it.
# Use a dedicated PostgreSQL role with access only to repro_reports.
REPRO_USERNAME=
REPRO_PASSWORD=
REPRO_HEADLESS=true
REPRO_DOWNLOAD_DIR=downloads
REPRO_ERROR_LOG=logs/download_errors.log
PLAYWRIGHT_BROWSERS_PATH=SET_BY_IT
REPRO_DB_BACKEND=postgres
REPRO_PG_HOST=SET_BY_IT
REPRO_PG_PORT=5432
REPRO_PG_DATABASE=repro_reports
REPRO_PG_USER=SET_BY_IT
REPRO_PG_PASSWORD=
REPRO_SQLITE_PATH=reports.sqlite3

# Company SSO gateway must authenticate users and inject these headers.
# It must strip incoming client values for both identity and role headers.
REPRO_AUTH_REQUIRED=true
REPRO_AUTH_USER_HEADER=X-Authenticated-User
REPRO_AUTH_ROLES_HEADER=X-Authenticated-Roles
REPRO_ADMIN_ROLE=DSM-Admin
REPRO_AUTOMATION_ROLE=DSM-Users

# Set the exact direct peer FastAPI sees and the dashboard origin supplied by IT.
# Uvicorn uses --no-proxy-headers; Caddy connects to FastAPI over loopback.
REPRO_TRUSTED_PROXY_IPS=127.0.0.1
REPRO_CORS_ORIGINS=https://SET_BY_IT

# Optional Master Excel folder visible to the service account.
REPRO_MASTER_EXCEL_DIR=
